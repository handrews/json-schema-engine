  "fastify-default-config": {
    "dialect": "2020-12",
    "options": {
      "coerceTypes": "array",
      "useDefaults": true,
      "removeAdditional": true,
      "allErrors": false,
      "addUsedSchema": false
    },
    "schema": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page": {
          "type": "integer",
          "default": 1
        }
      }
    },
    "data": {
      "id": "42",
      "tags": "solo",
      "junk": true
    },
    "valid": true,
    "dataAfter": {
      "id": 42,
      "tags": ["solo"],
      "page": 1
    },
    "errors": null
  },
