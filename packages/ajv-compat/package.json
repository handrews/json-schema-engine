{
  "name": "@json-schema-engine/ajv-compat",
  "version": "0.0.4",
  "private": true,
  "description": "AJV v8 migration adapter over @json-schema-engine/core: emulated API surface for a documented subset, pinned against executed-AJV fixtures, with typed loud failures for the AJV-implementation-coupled surface (see COMPAT.md)",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "jse-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@json-schema-engine/compiler": "^0.0.4",
    "@json-schema-engine/core": "^0.0.4",
    "@json-schema-engine/formats": "^0.0.4"
  },
  "devDependencies": {
    "@fastify/ajv-compiler": "^4.0.6",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "fastify": "^5.12.5",
    "light-my-request": "^6.6.0"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handrews/json-schema-engine.git",
    "directory": "packages/ajv-compat"
  }
}
