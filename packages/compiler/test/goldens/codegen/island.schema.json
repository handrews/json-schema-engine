{
  "$defs": {
    "tree": {
      "$id": "tree",
      "$dynamicAnchor": "node",
      "type": "object",
      "properties": {
        "child": {
          "$dynamicRef": "#node"
        }
      }
    },
    "strict": {
      "$id": "strict",
      "$dynamicAnchor": "node",
      "$ref": "tree",
      "properties": {
        "data": {
          "type": "integer"
        }
      }
    },
    "loose": {
      "$id": "loose",
      "$dynamicAnchor": "node",
      "$ref": "tree",
      "properties": {
        "data": {
          "type": "string"
        }
      }
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "strict"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "$ref": "strict"
  },
  "else": {
    "$ref": "loose"
  }
}
