{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "customConditions": ["jse-source"],
    "types": ["node"]
  },
  "include": [
    "spike",
    "bench",
    "packages",
    "bowtie",
    "scripts",
    "vitest.config.ts"
  ],
  "exclude": ["**/.snippets"]
}
