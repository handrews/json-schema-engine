{
  "name": "json-schema-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Annotation-first two-tier JSON Schema engine: spec-complete interpreter + compiled validators, all standard formats, AJV migration adapter (monorepo)",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bench": "tsx --conditions=jse-source spike/bench.ts",
    "bench:harness": "tsx --conditions=jse-source bench/harness.ts",
    "build": "tsc -b tsconfig.build.json",
    "fuzz": "tsx --conditions=jse-source scripts/fuzz.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "typedoc",
    "csp:check": "tsx --conditions=jse-source scripts/csp-check.ts",
    "pack:check": "tsx --conditions=jse-source scripts/pack-check.ts",
    "bowtie": "tsx scripts/bowtie-check.ts",
    "verify": "npm run check-types && npm run lint && npm run format:check && npm test && npm run docs:api && npm run csp:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hyperjump/json-schema": "^1.17.7",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "prettier": "^3.9.6",
    "tinybench": "^6.1.2",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  }
}
